#!/usr/bin/env bash
# ==============================================================================
# FOCP Secure Requirements Studio v2 — One-Click Runner (Linux Omarchy / Bash / WSL)
# ==============================================================================

set -e

BOLD='\033[1m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${CYAN}=======================================================${NC}"
echo -e "${GREEN}${BOLD}   FOCP Secure Requirements Studio v2 — Starting Up    ${NC}"
echo -e "${CYAN}=======================================================${NC}"

# 1. Environment file setup
if [ ! -f backend/.env ]; then
    echo -e "${YELLOW}--> [1/4] Copying backend/.env.example to backend/.env...${NC}"
    cp backend/.env.example backend/.env
else
    echo -e "${GREEN}--> [1/4] backend/.env already present.${NC}"
fi

# 2. Check AI provider configuration
echo -e "\n${YELLOW}--> [2/4] Checking AI provider configuration...${NC}"
echo -e "${GREEN}--> AI provider will be configured via backend/.env${NC}"
echo -e "${CYAN}--> If using Google Gemini, set GEMINI_API_KEY in backend/.env${NC}"

echo -e "${GREEN}✔ Configuration ready. The backend will use Gemini or template mode based on environment variables.${NC}"

# 3. Launching browser in background
(
    sleep 6
    echo -e "${CYAN}--> Opening browser at http://localhost:3000 ...${NC}"
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open http://localhost:3000 >/dev/null 2>&1 || true
    elif command -v open >/dev/null 2>&1; then
        open http://localhost:3000 >/dev/null 2>&1 || true
    fi
) &

# 4. Start Stack (Docker Compose or Local)
echo -e "\n${YELLOW}--> [3/4] Detecting stack orchestration mode...${NC}"

DOCKER_OK=false
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    DOCKER_OK=true
fi

if [ "$DOCKER_OK" = true ]; then
    echo -e "${GREEN}--> Docker is running. Launching platform with Docker Compose...${NC}"
    echo -e "${GREEN}--> App URL:       http://localhost:3000${NC}"
    echo -e "${GREEN}--> Backend API:   http://localhost:8000/api/v1${NC}"
    echo -e "${GREEN}--> Ollama Host:   http://localhost:11434${NC}"
    echo -e "${CYAN}=======================================================${NC}"

    if command -v "docker-compose" >/dev/null 2>&1; then
        docker-compose up --build
    else
        docker compose up --build
    fi
else
    echo -e "${YELLOW}--> Docker daemon is not active. Starting local development servers...${NC}"
    echo -e "${GREEN}--> Starting FastAPI backend on http://localhost:8000 ...${NC}"
    (cd backend && uvicorn app.main:app --reload --port 8000) &
    BACKEND_PID=$!

    echo -e "${GREEN}--> Starting Next.js frontend on http://localhost:3000 ...${NC}"
    (cd frontend && npm run dev) &
    FRONTEND_PID=$!

    trap "kill $BACKEND_PID $FRONTEND_PID 2>/dev/null || true" EXIT

    echo -e "${GREEN}--> Platform running! Press Ctrl+C to stop.${NC}"
    wait $BACKEND_PID $FRONTEND_PID
fi
