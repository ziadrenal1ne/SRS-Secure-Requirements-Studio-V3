#!/usr/bin/env bash
# ==============================================================================
# FOCP Secure Requirements Studio — One-Click Unified Runner
# Run with:  ./run
# ==============================================================================

set -e

BOLD='\033[1m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

echo -e "${CYAN}=======================================================${NC}"
echo -e "${GREEN}${BOLD}   FOCP Secure Requirements Studio — Starting Up       ${NC}"
echo -e "${CYAN}=======================================================${NC}"

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$ROOT_DIR/backend"
FRONTEND_DIR="$ROOT_DIR/frontend"

# 1. Environment file setup
if [ ! -f "$BACKEND_DIR/.env" ]; then
    if [ -f "$BACKEND_DIR/.env.example" ]; then
        echo -e "${YELLOW}--> [1/4] Copying backend/.env.example to backend/.env...${NC}"
        cp "$BACKEND_DIR/.env.example" "$BACKEND_DIR/.env"
    else
        echo -e "${YELLOW}--> [1/4] Creating basic backend/.env...${NC}"
        echo "ENVIRONMENT=development" > "$BACKEND_DIR/.env"
    fi
else
    echo -e "${GREEN}--> [1/4] backend/.env already present.${NC}"
fi

# 2. Python environment detection
PYTHON_BIN=""
if [ -f "$ROOT_DIR/.venv/Scripts/python.exe" ]; then
    PYTHON_BIN="$ROOT_DIR/.venv/Scripts/python.exe"
elif [ -f "$ROOT_DIR/.venv/bin/python" ]; then
    PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
elif [ -f "$BACKEND_DIR/.venv/bin/python" ]; then
    PYTHON_BIN="$BACKEND_DIR/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python"
else
    echo -e "${RED}[ERROR] Python interpreter not found.${NC}"
    exit 1
fi
echo -e "${GREEN}--> [2/4] Using Python: $PYTHON_BIN${NC}"

# 3. Frontend node check
if ! command -v node >/dev/null 2>&1; then
    echo -e "${RED}[ERROR] Node.js is required but not installed.${NC}"
    exit 1
fi
echo -e "${GREEN}--> [3/4] Node.js environment detected.${NC}"

# 4. Start stack locally
echo -e "\n${YELLOW}--> [4/4] Launching FastAPI Backend & Next.js Frontend...${NC}"
echo -e "${GREEN}--> Starting FastAPI backend on http://localhost:8000 ...${NC}"

(cd "$BACKEND_DIR" && "$PYTHON_BIN" -m uvicorn app.main:app --reload --port 8000) &
BACKEND_PID=$!

echo -e "${GREEN}--> Starting Next.js frontend on http://localhost:3000 ...${NC}"
(cd "$FRONTEND_DIR" && npm run dev) &
FRONTEND_PID=$!

# Open browser after short delay
(
    sleep 5
    if command -v start >/dev/null 2>&1; then
        cmd.exe /c start http://localhost:3000 >/dev/null 2>&1 || true
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open http://localhost:3000 >/dev/null 2>&1 || true
    elif command -v open >/dev/null 2>&1; then
        open http://localhost:3000 >/dev/null 2>&1 || true
    fi
) &

trap 'echo -e "\n${YELLOW}Stopping backend ($BACKEND_PID) and frontend ($FRONTEND_PID)...${NC}"; kill $BACKEND_PID $FRONTEND_PID 2>/dev/null || true; exit 0' INT TERM EXIT

echo ""
echo -e "${GREEN}=======================================================${NC}"
echo -e "${GREEN}${BOLD} Everything started successfully!                       ${NC}"
echo -e "${CYAN} App     : http://localhost:3000${NC}"
echo -e "${CYAN} API     : http://localhost:8000/api/v1${NC}"
echo -e "${CYAN} AI Docs : http://localhost:8000/docs${NC}"
echo -e "${GREEN}=======================================================${NC}"
echo -e "${GRAY} Press Ctrl+C to stop all services.${NC}"
echo ""

wait $BACKEND_PID $FRONTEND_PID
