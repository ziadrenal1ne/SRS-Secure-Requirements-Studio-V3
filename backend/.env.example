ENVIRONMENT=development
DEBUG=true

# Local dev uses SQLite (no Docker required). Switch to PostgreSQL URL when using Docker.
DATABASE_URL=sqlite+aiosqlite:///./srs_local.db

# Redis is optional for local dev — Celery is not used in local mode
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=srs-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# AI Provider: "gemini" or "template" (no-network fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.95
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_ENABLE_STREAMING=false

# Uncomment and fill to use Anthropic Claude instead of Gemini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
