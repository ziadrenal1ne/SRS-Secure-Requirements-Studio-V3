#!/usr/bin/env bash
# ==============================================================================
# FOCP Secure Requirements Studio v2 - One-Click Runner (Linux / Omarchy / WSL)
# Run with:  ./runlinux
# ==============================================================================

set -euo pipefail

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
GRAY='\033[0;90m'
NC='\033[0m'

echo ""
echo -e "${CYAN}=======================================================${NC}"
echo -e "${GREEN}   FOCP Secure Requirements Studio v2 - Starting Up   ${NC}"
echo -e "${CYAN}=======================================================${NC}"
echo ""

# ── 1. Ensure backend .env exists ─────────────────────────────────────────────
if [ ! -f backend/.env ]; then
    echo -e "${YELLOW}[1/4] Copying backend/.env.example -> backend/.env...${NC}"
    cp backend/.env.example backend/.env
else
    echo -e "${GREEN}[1/4] backend/.env already present.${NC}"
fi

# ── 2. Install backend dependencies (Poetry) ─────────────────────────────────
echo ""
echo -e "${YELLOW}[2/4] Ensuring backend Python dependencies are installed...${NC}"
if command -v poetry >/dev/null 2>&1; then
    (cd backend && poetry install --no-interaction -q)
    echo -e "${GREEN}[OK] Backend dependencies ready (poetry).${NC}"
elif command -v python3 >/dev/null 2>&1; then
    (cd backend && python3 -m poetry install --no-interaction -q)
    echo -e "${GREEN}[OK] Backend dependencies ready (python3 -m poetry).${NC}"
else
    echo -e "${RED}[X] Python/Poetry not found. Install from https://python-poetry.org${NC}"
fi

# ── 3. Check AI provider configuration ───────────────────────────────────────────────────
echo ""
echo -e "${YELLOW}[3/4] Checking AI provider configuration...${NC}"
echo -e "${GREEN}--> AI provider settings will be loaded from backend/.env${NC}"
echo -e "${CYAN}--> If using Google Gemini, set GEMINI_API_KEY in backend/.env${NC}"
echo -e "${GREEN}✔ Configuration ready. The backend will use Gemini or template mode based on environment variables.${NC}"
echo -e "${YELLOW}--> The application supports Gemini or template fallback only.${NC}"

# ── 4. Detect Docker or start locally ────────────────────────────────────────
echo ""
echo -e "${YELLOW}[4/4] Detecting orchestration mode...${NC}"

DOCKER_OK=false
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    DOCKER_OK=true
fi

if [ "$DOCKER_OK" = true ]; then
    echo ""
    echo -e "${GREEN}[DOCKER] Launching with Docker Compose...${NC}"
    echo -e "${CYAN}    App     : http://localhost:3000${NC}"
    echo -e "${CYAN}    API     : http://localhost:8000/api/v1${NC}"
    echo -e "${CYAN}    Ollama  : http://localhost:11434${NC}"
    echo -e "${CYAN}=======================================================${NC}"
    echo ""
    if command -v docker-compose >/dev/null 2>&1; then
        docker-compose up --build
    else
        docker compose up --build
    fi
else
    echo -e "${YELLOW}[LOCAL] Docker not running. Starting services locally...${NC}"

    # Determine backend command
    BACKEND_CMD="python3 -m poetry run uvicorn app.main:app --reload --port 8000"
    if command -v poetry >/dev/null 2>&1; then
        BACKEND_CMD="poetry run uvicorn app.main:app --reload --port 8000"
    fi

    echo -e "${GREEN}    [FastAPI] Starting on http://localhost:8000 ...${NC}"
    (cd backend && eval "$BACKEND_CMD") &
    BACKEND_PID=$!

    sleep 2

    echo -e "${GREEN}    [Next.js] Starting on http://localhost:3000 ...${NC}"
    (cd frontend && npm run dev) &
    FRONTEND_PID=$!

    # Open browser after short delay
    (
        sleep 8
        if command -v xdg-open >/dev/null 2>&1; then
            xdg-open http://localhost:3000 >/dev/null 2>&1 || true
        elif command -v open >/dev/null 2>&1; then
            open http://localhost:3000 >/dev/null 2>&1 || true
        fi
    ) &

    # Cleanup on Ctrl+C
    trap "echo ''; echo -e '${YELLOW}Stopping services...${NC}'; kill $BACKEND_PID $FRONTEND_PID 2>/dev/null || true; exit 0" INT TERM

    echo ""
    echo -e "${GREEN}=======================================================${NC}"
    echo -e "${GREEN} Everything started!                                   ${NC}"
    echo -e "${CYAN} App     : http://localhost:3000${NC}"
    echo -e "${CYAN} API     : http://localhost:8000/api/v1${NC}"
    echo -e "${CYAN} AI docs : http://localhost:8000/docs${NC}"
    echo -e "${GREEN}=======================================================${NC}"
    echo -e "${GRAY} Press Ctrl+C to stop all services.${NC}"
    echo ""

    wait $BACKEND_PID $FRONTEND_PID
fi
